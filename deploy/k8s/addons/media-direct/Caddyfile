# 비root로 돌므로 컨테이너 안에서는 8080·8443을 열고, 노드의 80·443(hostPort)을 여기로 잇는다
{
	http_port 8080
	https_port 8443
	admin off
}

{$MEDIA_HOST} {
	@video {
		method GET HEAD
		path_regexp ^/shorts/[0-9]{4}/[0-9]{2}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.mp4$
	}
	handle @video {
		# 스튜디오(devlog.life)가 fetch로 받아 제목 이름으로 저장하므로 그 주소만 읽게 연다(쿠키는 안 받음).
		# defer: MinIO가 붙이는 CORS·서버 머리글을 응답 직전에 덮어써 같은 머리글이 두 번 가지 않게 한다
		header {
			Access-Control-Allow-Origin "{$SITE_ORIGIN}"
			Vary Origin
			# 키가 매번 새 uuid라 내용이 바뀌지 않는다
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
			-Access-Control-Allow-Credentials
			-Access-Control-Expose-Headers
			-Server
			-X-Amz-Request-Id
			-X-Amz-Id-2
			defer
		}
		# 질의 문자열(?acl 같은 S3 명령)은 버리고 공개 버킷의 그 파일만 읽는다
		rewrite * /{$S3_BUCKET}{path}
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			# 브라우저의 Origin을 MinIO에 넘기지 않는다(CORS는 위에서 정함)
			header_up -Origin
		}
	}
	handle {
		respond 404
	}
}
