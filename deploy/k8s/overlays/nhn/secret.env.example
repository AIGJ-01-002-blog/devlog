# 이 파일을 secret.env로 복사해 실제 값을 넣는다. secret.env는 절대 커밋하지 않는다.
# CI에서는 GitHub Secret BLOG_SECRET_ENV(이 파일 전체 내용)로 만든다.
DB_USERNAME=example_user
DB_PASSWORD=example_password
REDIS_PASSWORD=example_password
GITHUB_CLIENT_ID=example_client_id
GITHUB_CLIENT_SECRET=example_client_secret
# 아무 긴 임의 문자열 (예: openssl rand -base64 48)
CURSOR_SECRET=example_cursor_secret_change_me
S3_ACCESS_KEY=example_access_key
S3_SECRET_KEY=example_secret_key
RABBITMQ_USERNAME=example_user
RABBITMQ_PASSWORD=example_password
ELASTICSEARCH_USERNAME=example_user
ELASTICSEARCH_PASSWORD=example_password
# Google 로그인 (004). 비워 두면 Google 버튼이 숨겨지고 앱은 그대로 뜬다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오 로그인 (080). 비워 두면 카카오 버튼이 숨겨진다. 비즈 앱 전환 전이면 KAKAO_SCOPES=profile_nickname,profile_image
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_SCOPES=
# 인증·재설정 메일 (004). SMTP_HOST를 비워 두면 메일을 보내지 않는다(가입은 되지만 인증 메일이 가지 않음)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 예: devlog <no-reply@도메인>. 비워 두면 devlog <no-reply@devlog.local>
MAIL_FROM=
# AI 태그 추천(018): Gemini API 열쇠. 비워 두면 외부 AI를 쓰지 않는다(OLLAMA_BASE_URL도 비면 기능이 꺼짐)
GEMINI_API_KEY=
# 텔레그램 봇(023): @BotFather 토큰. 비워 두면 텔레그램 연결·알림·메모가 꺼지고 설정 화면에서 숨는다
TELEGRAM_BOT_TOKEN=
# 쇼츠 자동 올리기(spec 108). 비워 두면 스튜디오에 [자동 올리기]가 보이지 않는다. 안내: specs/108-shorts-auto-upload/owner-setup.md
# 토큰 암호화 열쇠: openssl rand -base64 32 (바꾸면 이어 둔 계정을 다시 연결해야 한다)
SHORTS_TOKEN_KEY=
# Google Cloud 콘솔의 OAuth 클라이언트(웹 애플리케이션). YouTube Data API v3를 켠 프로젝트
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta 앱 대시보드 → Instagram → API setup with Instagram login의 Instagram 앱 ID·시크릿
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
