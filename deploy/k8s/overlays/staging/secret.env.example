# 배포 워크플로가 처음 한 번 deploy/scripts/gen-secret-env.sh staging 으로 임의 값을 채워 클러스터의 blog-dev-seed Secret에 둔다.
# 운영 값(BLOG_SECRET_ENV)은 쓰지 않는다. secret.env는 커밋하지 않는다.
DB_USERNAME=blog
DB_PASSWORD=example_password
REDIS_PASSWORD=example_password
CURSOR_SECRET=example_cursor_secret_change_me
S3_ACCESS_KEY=blogminio
S3_SECRET_KEY=example_password
# 쇼츠 자동 올리기(spec 108). 비워 두면 스튜디오에 [자동 올리기]가 보이지 않는다. 안내: specs/108-shorts-auto-upload/owner-setup.md
# 토큰 암호화 열쇠: openssl rand -base64 32 (바꾸면 이어 둔 계정을 다시 연결해야 한다)
SHORTS_TOKEN_KEY=
# Google Cloud 콘솔의 OAuth 클라이언트(웹 애플리케이션). YouTube Data API v3를 켠 프로젝트
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta 앱 대시보드 → Instagram → API setup with Instagram login의 Instagram 앱 ID·시크릿
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
