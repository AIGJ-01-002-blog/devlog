# 시험 환경의 비밀이 아닌 설정. 운영(overlays/selfhosted/app.env)과 다른 곳만 바꿨다.
DB_URL=jdbc:postgresql://postgres:5432/blog
DB_SCHEMA=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# 시험 주소. ingress host(kustomization.yaml)와 함께 바꾼다. 바깥에서는 Cloudflare Access로 막는다(deploy/README.md "시험 환경")
SITE_BASE_URL=https://dev.devlog.life
COOKIE_SECURE=true
TRUSTED_PROXIES=10.244.0.0/16,10.42.0.0/16
# 클러스터 안 Cloudflare 터널 뒤라 X-Forwarded-For에 터널 파드 주소만 남는다. Cloudflare가 넣는 사용자 IP 머리글을 쓴다
CLIENT_IP_HEADER=CF-Connecting-IP
# 소셜 로그인 앱은 운영 주소로만 등록돼 있어 시험 환경에서는 이메일 가입·로그인으로 들어간다.
# 개발용 로그인(/api/dev/login)은 비밀번호 없이 아무 계정(관리자 포함)으로 들어가므로 끈다(보안 점검 2026-10-15, 민서님 결정).
# 메일 열쇠가 없고 개발용 로그인도 꺼져 있어 가입 인증번호는 묻지 않는다(SIGNUP_EMAIL_CODE=auto)
DEV_LOGIN_ENABLED=false
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=https://dev.devlog.life/blog-images
# 메일·AI·텔레그램·검색 임베딩은 켜지 않는다(운영 열쇠를 시험 환경에 넣지 않음)
EMBED_BASE_URL=
OWNER_HANDLE=kim755030
