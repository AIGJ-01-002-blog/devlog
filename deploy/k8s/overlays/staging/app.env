# 시험 환경의 비밀이 아닌 설정. 운영(overlays/selfhosted/app.env)과 다른 곳만 바꿨다.
DB_URL=jdbc:postgresql://postgres:5432/blog
DB_SCHEMA=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# 시험 주소. ingress host(kustomization.yaml)와 함께 바꾼다. 바깥에서는 Cloudflare Access로 막는다(deploy/README.md "시험 환경")
SITE_BASE_URL=https://dev.devlog.life
COOKIE_SECURE=true
TRUSTED_PROXIES=10.244.0.0/16,10.42.0.0/16
# 소셜 로그인 앱은 운영 주소로만 등록돼 있어 시험 환경에서는 개발용 로그인(/api/dev/login)과 이메일 가입으로 들어간다.
# 보낸 메일은 /api/dev/mails 에서 본다. Access 뒤에 있어 바깥 사람은 닿지 않는다
DEV_LOGIN_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=https://dev.devlog.life/blog-images
# 메일·AI·텔레그램·검색 임베딩은 켜지 않는다(운영 열쇠를 시험 환경에 넣지 않음)
EMBED_BASE_URL=
OWNER_HANDLE=kim755030
