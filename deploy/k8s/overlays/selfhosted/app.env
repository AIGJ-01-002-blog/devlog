# 비밀이 아닌 설정. 이름은 /mnt/project-files/infra/app-env-vars.md 와 같다.
# 의존 서비스는 모두 같은 네임스페이스 안의 서비스 이름으로 찾는다.
DB_URL=jdbc:postgresql://postgres:5432/blog
DB_SCHEMA=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# 서비스 도메인 (2026-10-07 민서님 구매). ingress host(kustomization.yaml)와 함께 바꾼다
SITE_BASE_URL=https://devlog.life
COOKIE_SECURE=true
# 인그레스 컨트롤러 파드 대역(CIDR, 쉼표 구분)
TRUSTED_PROXIES=10.244.0.0/16,10.42.0.0/16
# 클러스터 안 Cloudflare 터널 뒤라 X-Forwarded-For에 터널 파드 주소만 남는다. Cloudflare가 넣는 사용자 IP 머리글을 쓴다
CLIENT_IP_HEADER=CF-Connecting-IP
DEV_LOGIN_ENABLED=false
# 사진: 클러스터 안 MinIO, 브라우저는 같은 주소의 /blog-images/ 로 받는다
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=https://devlog.life/blog-images
# 메일(004): 블로그 운영용 Gmail 계정. 비밀번호(Gmail 앱 비밀번호)와 SMTP_HOST는 secret.env에 둔다.
# SMTP_HOST가 비어 있으면 앱은 메일을 보내지 않고 보관만 한다(비밀번호 없이 보내다 실패하는 것을 막음).
SMTP_PORT=587
SMTP_USERNAME=devlogaip@gmail.com
MAIL_FROM=devlog <devlogaip@gmail.com>
# AI(018·061): 지금 앱은 Gemini가 먼저, 한도 초과·사용 불가 때 Ollama(docs/61 앱 변경 뒤에는 Ollama가 먼저). 주소(OLLAMA_BASE_URL, 예: https://ai.devlog.life)는
# 배포 때 GitHub 변수 OLLAMA_BASE_URL에서 넣는다(비우면 Ollama를 쓰지 않음). Access 토큰·Gemini 열쇠는 Secret.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_CONCURRENCY=1
OLLAMA_DOWN_FOR=60s
# 하이브리드 검색(054): 글·검색어 임베딩은 클러스터 안 Ollama(bge-m3, CPU). 집 PC가 꺼져도 의미 검색이 돈다
EMBED_BASE_URL=http://ollama-embed:11434
# 운영자 계정(062): 이 블로그 주소의 계정을 앱이 뜰 때 관리자로 올린다(민서님 devlog.life/@kim755030). 비밀값 아님
OWNER_HANDLE=kim755030
# 숏폼 스튜디오(099)·매매 일지(243): 블로그 주인이 화면을 확인해 운영에서 켠다(#256).
# 렌더 워커 토큰 SHORTS_WORKER_TOKEN은 비밀값이라 GitHub Secret으로 넣는다. 없으면 대본까지만 되고 영상은 만들지 않는다
SHORTS_ENABLED=true
TRADES_ENABLED=true
